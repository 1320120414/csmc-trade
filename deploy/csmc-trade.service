# systemd 服务文件 - CSMC 饰品交易平台
# 安装: sudo cp deploy/csmc-trade.service /etc/systemd/system/
# 启动: sudo systemctl daemon-reload && sudo systemctl enable csmc-trade && sudo systemctl start csmc-trade
# 查看日志: sudo journalctl -u csmc-trade -f

[Unit]
Description=CSMC Trade Platform
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/csmc-trade
Environment="CSMC_SECRET_KEY=改成你的随机密钥"
ExecStart=/opt/csmc-trade/venv/bin/gunicorn -c gunicorn_config.py "app:app"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
